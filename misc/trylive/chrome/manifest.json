{
  "manifest_version": 3,
  "name": "Printer Extension",
  "version": "1.0",
  "description": "Interact with printers from a Chrome extension",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["printerProvider", "webNavigation"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popup.js"]
    }
  ]
}
